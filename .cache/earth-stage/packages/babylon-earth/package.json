{
    "name": "@spacexr/babylon-earth",
    "version": "0.1.0",
    "description": "Earth composition for Babylon using Celestial, the SpaceXR 3D Tiles runtime and spectral atmosphere.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/spacexr-rendering.git",
        "directory": "packages/babylon-earth"
    },
    "homepage": "https://github.com/pandaGaume/spacexr-rendering#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/spacexr-rendering/issues"
    },
    "keywords": [
        "earth",
        "babylonjs",
        "atmosphere",
        "3d-tiles"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "shaders": "node scripts/build-shader.mjs",
        "prebuild": "npm run shaders",
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "npm run shaders && tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "peerDependencies": {
        "@babylonjs/core": "^9.33.1"
    },
    "dependencies": {
        "@spacexr/3d-tiles-core": "0.1.0",
        "@spacexr/3d-tiles-runtime": "0.1.0",
        "@spacexr/dem": "0.1.0",
        "@spacexr/geodesy": "0.4.0",
        "@spacexr/grid": "0.1.0",
        "@spacexr/raster": "0.1.0",
        "@spacexr/tiles": "0.1.0",
        "@spacexr/3d-tiles-babylon": "0.1.0",
        "@spacexr/celestial-core": "0.1.0",
        "@spacexr/atmosphere": "0.1.0",
        "@webgpu/types": "^0.1.74"
    },
    "devDependencies": {
        "@babylonjs/core": "^9.33.1",
        "@babylonjs/loaders": "^9.33.1",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "rimraf": "~6.1.3",
        "tslib": "^2.9.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.4.0",
        "vitest": "4.1.12"
    }
}
