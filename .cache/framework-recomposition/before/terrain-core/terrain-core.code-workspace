            },
            {
                "label": "Watch: raster",
                "type": "shell",
                "command": "npm",
                "args": [
                    "run",
                    "watch",
                    "--workspace",
                    "@spacexr/raster"
                ],
                "options": {
                    "cwd": "${workspaceFolder:Terrain}"
                },
                "problemMatcher": [],
                "isBackground": true
            },
            {
                "label": "Watch: dem",
                "type": "shell",
                "command": "npm",
                "args": [
                    "run",
                    "watch",
                    "--workspace",
                    "@spacexr/dem"
                ],
                "options": {
                    "cwd": "${workspaceFolder:Terrain}"
                },
                "problemMatcher": [],
