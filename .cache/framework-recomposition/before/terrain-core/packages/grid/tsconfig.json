{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "node"
        ],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "declaration": true,
        "sourceMap": true,
        "removeComments": false,
        "importHelpers": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@spacexr/tiles": [
                "../tiles/src/index.ts"
            ],
            "@spacexr/tiles/*": [
                "../tiles/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts",
        "tsup.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "coverage"
    ]
}
