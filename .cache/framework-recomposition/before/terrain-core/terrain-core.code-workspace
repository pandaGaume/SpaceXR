            },
            {
                "label": "Watch: grid",
                "type": "shell",
                "command": "npm",
                "args": [
                    "run",
                    "watch",
                    "--workspace",
                    "@spacexr/grid"
                ],
                "options": {
                    "cwd": "${workspaceFolder:Terrain}"
                },
                "problemMatcher": [],
                "isBackground": true
            },
            {
                "label": "Watch: 3d-tiles-babylon",
                "type": "shell",
                "command": "npm",
                "args": [
                    "run",
                    "watch",
                    "--workspace",
                    "@spacexr/3d-tiles-babylon"
                ],
                "options": {
                    "cwd": "${workspaceFolder:Rendering}"
                },
                "problemMatcher": [],
                "isBackground": true
            }
        ]
    }
}
