{
    "name": "@spacexr/example-babylon-implicit-grid-mapzen",
    "version": "0.1.0",
    "private": true,
    "description": "Babylon.js proof of the renderer-neutral 3D Tiles pipeline: an implicit Web Mercator quadtree of ellipsoid-projected grids elevated with Mapzen Terrarium.",
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "dev": "vite --force",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint \"src/**/*.ts\" \"*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"*.ts\" --fix",
        "format": "prettier --check \"src/**/*.{ts,css}\" \"*.{ts,json,md,html}\"",
        "format:fix": "prettier --write \"src/**/*.{ts,css}\" \"*.{ts,json,md,html}\"",
        "check": "npm run format && npm run lint && npm run typecheck && npm run build"
    },
    "dependencies": {
        "@babylonjs/core": "^9.33.1",
        "@babylonjs/loaders": "^9.33.1",
        "@spacexr/3d-tiles-babylon": "0.1.0",
        "@spacexr/3d-tiles-core": "0.1.0",
        "@spacexr/3d-tiles-runtime": "0.1.0",
        "@spacexr/dem": "0.1.0",
        "@spacexr/geodesy": "0.4.0",
        "@spacexr/grid": "0.1.0",
        "@spacexr/raster": "0.1.0",
        "@spacexr/tiles": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "typescript": "^5.4.0",
        "vite": "^6.4.5"
    }
}
