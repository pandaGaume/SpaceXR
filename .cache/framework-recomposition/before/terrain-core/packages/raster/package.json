{
    "name": "@spacexr/raster",
    "version": "0.1.0",
    "description": "Renderer-neutral tile rasters: multi-channel grids, bilinear sampling, image decoding, seamless stitching of neighbouring tiles and on-demand raster pyramids.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/3d-tiles-core.git",
        "directory": "node/packages/raster"
    },
    "homepage": "https://github.com/pandaGaume/3d-tiles-core#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/3d-tiles-core/issues"
    },
    "keywords": [
        "raster",
        "imagery",
        "texture",
        "elevation",
        "tiles",
        "stitching",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@spacexr/tiles": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "rimraf": "~6.1.4",
        "tslib": "^2.9.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "4.1.12"
    }
}
