{
    "name": "spacexr",
    "version": "1.0.0",
    "description": "3D terrain rendering in WebXR",
    "private": true,
    "workspaces": [
        "packages/**/*"
    ],
    "scripts": {
        "start": "node -r @dev/build-tools",
        "build": "tsc -b tsconfig.all.json",
        "build:watch": "tsc -b tsconfig.all.json --watch",
        "build:all:dev": "npm run --prefix ./packages/dev/core build && npm run --prefix ./packages/dev/space build && npm run --prefix ./packages/dev/extensions/mapbox build && npm run --prefix ./packages/dev/babylon build && echo All packages built successfully!",
        "publish:all:dev": "npm run --prefix ./packages/dev/core publish:dev && npm run --prefix ./packages/dev/space publish:dev && npm run --prefix ./packages/dev/extensions/mapbox publish:dev && npm run --prefix ./packages/dev/babylon publish:dev && echo All packages published successfully!",
        "lint": "npm run lint:check",
        "lint:check": "eslint \"packages/**/src/**/*.{ts,tsx}\" --quiet",
        "lint:fix": "eslint \"packages/**/src/**/*.{ts,tsx}\" --fix",
        "format": "npm run format:check",
        "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx,js,json,scss,css}\"",
        "format:fix": "prettier --write \"packages/**/src/**/*.{ts,tsx,js,json,scss,css}\"",
        "clean": "rimraf packages/dev/*/dist packages/dev/*/types packages/dev/*/bundles packages/dev/extensions/*/dist packages/dev/extensions/*/types packages/dev/extensions/*/bundles *.tsbuildinfo"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=20.11.0"
    },
    "devDependencies": {
        "@babylonjs/core": "^8.49.3",
        "@babylonjs/gui": "^8.49.3",
        "@babylonjs/inspector": "^8.49.3",
        "@babylonjs/loaders": "^8.49.3",
        "@babylonjs/materials": "^8.49.3",
        "@types/jest": "^29.5.1",
        "@types/node": "^18.15.10",
        "@types/webxr": "^0.5.22",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "copyfiles": "^2.4.1",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "jest": "^29.5.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.4.0",
        "webpack": "^5.105.0",
        "webpack-cli": "^5.0.1"
    },
    "dependencies": {
        "@mapbox/vector-tile": "^2.0.2",
        "fflate": "^0.8.2",
        "pbf": "^4.0.1",
        "quickhull3d": "^2.1.0",
        "tslib": "^2.8.1"
    }
}
