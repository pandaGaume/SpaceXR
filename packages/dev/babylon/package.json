{
    "name": "spacexr-babylon",
    "version": "1.0.0",
    "main": "dist/index",
    "module": "dist/index",
    "esnext": "dist/index",
    "types": "dist/index",
    "private": true,
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "npm run clean && npm run compile",
        "clean": "rimraf -g dist bundle bundles types *.tsbuildinfo",
        "compile": "npm run precompile && tsc -b tsconfig.build.json",
        "precompile": "npx build-tools -c process-assets",
        "watch:source": "tsc -b tsconfig.build.json -w",
        "lint": "npm run lint:check",
        "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
        "bundle": "webpack --mode production",
        "bundle:dev": "webpack --mode development --stats-error-details",
        "copy:bundle": "copyfiles -V -u 1 \"./bundles/*.*\" \"../../host/www/libs\"",
        "publish:dev": "npm run build && npm run bundle:dev && npm run copy:bundle"
    },
    "sideEffects": false,
    "devDependencies": {
        "@dev/build-tools": "^1.0.0"
    },
    "dependencies": {
        "path-scurry": "^1.10.1"
    }
}
