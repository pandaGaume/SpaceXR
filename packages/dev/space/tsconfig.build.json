{
    "extends": "../../../tsconfig.build.json",
    "compilerOptions": {
        "esModuleInterop": true,
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "declarationDir": "./types",
        "skipLibCheck": true,
        "paths": {
            "core/*": ["./dev/core/src/*"]
        }
    },
    "references": [{ "path": "../core/tsconfig.build.json" }],
    "include": ["./src/**/*.ts"],
    "exclude": ["**/node_modules", "**/dist", "**/types"]
}
