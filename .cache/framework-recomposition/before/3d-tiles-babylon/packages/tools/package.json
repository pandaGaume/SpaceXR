{
    "name": "@spacexr/3d-tiles-babylon-tools",
    "version": "0.0.0",
    "private": true,
    "description": "Build and measure tools of the 3D Tiles Babylon.js adaptation: compiles shader files into TypeScript modules, and flies camera paths over the terrain.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "bench:terrain": "tsx src/terrain-bench/cli.ts",
        "compare:renderers": "tsx src/terrain-bench/renderers.ts"
    },
    "dependencies": {
        "@spacexr/raster": "0.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^5.4.0",
        "vitest": "4.1.12"
    }
}
